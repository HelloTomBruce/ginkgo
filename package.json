{
  "name": "ginkgo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -p 3006",
    "build": "next build",
    "start": "next start -p 3006",
    "lint": "eslint",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "eval:tier-b": "pnpm --filter @ginkgolab/app-analytics eval:tier-b",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "storage:migrate": "node scripts/storage-migrate.mjs",
    "dev:clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\" && next dev -p 3006"
  },
  "dependencies": {
    "@ai-sdk/react": "1.1.20",
    "@ginkgolab/app-analytics": "workspace:*",
    "@ginkgolab/app-design": "workspace:*",
    "@ginkgolab/app-general": "workspace:*",
    "@ginkgolab/app-sdk": "workspace:*",
    "@ginkgolab/chart-spec": "workspace:*",
    "@ginkgolab/components": "workspace:*",
    "@ginkgolab/datasources": "workspace:*",
    "@ginkgolab/harness-core": "workspace:*",
    "@ginkgolab/llm": "workspace:*",
    "@ginkgolab/models": "workspace:*",
    "@ginkgolab/sandbox": "workspace:*",
    "@openuidev/react-lang": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^30.1.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.10.1",
  "license": "MIT"
}
