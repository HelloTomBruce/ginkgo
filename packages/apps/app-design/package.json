{
  "name": "@ginkgolab/app-design",
  "version": "0.1.5",
  "description": "Experience Design Studio app for Ginkgo platform",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./definition": "./src/index.ts",
    "./manifest": "./src/manifestMeta.ts",
    "./server": "./src/server/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js"
      },
      "./definition": {
        "types": "./dist/definition.d.ts",
        "import": "./dist/definition.js"
      },
      "./manifest": {
        "types": "./dist/manifestMeta.d.ts",
        "import": "./dist/manifestMeta.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@ginkgolab/app-sdk": "workspace:*",
    "@ginkgolab/harness-core": "workspace:*",
    "@ginkgolab/sandbox": "workspace:*",
    "lucide-react": "^1.73.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.2",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT"
}
