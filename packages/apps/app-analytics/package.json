{
  "name": "@ginkgolab/app-analytics",
  "version": "0.1.2",
  "description": "Intelligent Data Analytics app for Ginkgo platform",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./definition": "./src/index.ts",
    "./isomorphic": "./src/isomorphic/index.ts",
    "./isomorphic/dashboardCapture": "./src/isomorphic/dashboardCapture.ts",
    "./manifest": "./src/manifestMeta.ts",
    "./server": "./src/server/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js"
      },
      "./definition": {
        "types": "./dist/definition.d.ts",
        "import": "./dist/definition.js"
      },
      "./isomorphic": {
        "types": "./dist/isomorphic.d.ts",
        "import": "./dist/isomorphic.js"
      },
      "./isomorphic/dashboardCapture": {
        "types": "./dist/dashboardCapture.d.ts",
        "import": "./dist/dashboardCapture.js"
      },
      "./manifest": {
        "types": "./dist/manifestMeta.d.ts",
        "import": "./dist/manifestMeta.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "eval:tier-b": "vitest run src/evals/tier-b.real-model.test.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.1",
    "@duckdb/node-api": "2.0.0-r.1",
    "@ginkgolab/app-sdk": "workspace:*",
    "@ginkgolab/chart-spec": "workspace:*",
    "@ginkgolab/components": "workspace:*",
    "@ginkgolab/datasources": "workspace:*",
    "@openuidev/lang-core": "^0.3.1",
    "@openuidev/react-lang": "^0.3.1",
    "ai": "4.3.19",
    "cn": "^0.5.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.73.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "recharts": "^3.10.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@ginkgolab/llm": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.2",
    "mysql2": "^3.24.5",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "use-sync-external-store": "^1.4.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT"
}
