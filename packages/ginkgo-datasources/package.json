{
  "name": "@ginkgolab/datasources",
  "version": "0.1.2",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./adapters/ai": "./src/adapters/ai.ts",
    "./schema/card": "./src/schema/card.ts",
    "./schema/store": "./src/schema/store.ts",
    "./sqlGuard": "./src/connectors/db/sqlGuard.ts",
    "./parseToolResult": "./src/parseToolResult.ts",
    "./gateway": "./src/gateway/queryGateway.ts",
    "./certified": "./src/certified/certifiedStore.ts"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.1",
    "@duckdb/node-api": "2.0.0-r.1",
    "exceljs": "^4.4.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "ai": "*"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./adapters/ai": {
        "types": "./dist/adapters/ai.d.ts",
        "import": "./dist/adapters/ai.js"
      },
      "./schema/card": {
        "types": "./dist/schema/card.d.ts",
        "import": "./dist/schema/card.js"
      },
      "./schema/store": {
        "types": "./dist/schema/store.d.ts",
        "import": "./dist/schema/store.js"
      },
      "./sqlGuard": {
        "types": "./dist/sqlGuard.d.ts",
        "import": "./dist/sqlGuard.js"
      },
      "./parseToolResult": {
        "types": "./dist/parseToolResult.d.ts",
        "import": "./dist/parseToolResult.js"
      },
      "./gateway": {
        "types": "./dist/gateway.d.ts",
        "import": "./dist/gateway.js"
      },
      "./certified": {
        "types": "./dist/certified.d.ts",
        "import": "./dist/certified.js"
      }
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT"
}
