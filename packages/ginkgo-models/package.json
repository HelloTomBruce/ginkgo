{
  "name": "@ginkgolab/models",
  "version": "0.1.2",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./presets": "./src/presets.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/utils.ts"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./presets": {
        "types": "./dist/presets.d.ts",
        "import": "./dist/presets.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.js"
      },
      "./utils": {
        "types": "./dist/utils.d.ts",
        "import": "./dist/utils.js"
      }
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT"
}
